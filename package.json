{
  "name": "@lkonga/opencode-githubrepo",
  "version": "1.0.11",
  "description": "OpenCode plugin: semantic code search across GitHub repositories using Copilot embeddings",
  "type": "module",
  "main": "./index.ts",
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./pi.ts"
    ]
  },
  "files": [
    "index.ts",
    "mcp-server.ts",
    "cli.ts",
    "skills/",
    "omo.ts",
    "omp.ts",
    "pi.ts",
    "tui.ts",
    "README.md"
  ],
  "repository": {
