  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.10.19",
    "@oh-my-pi/pi-coding-agent": "^18.6.0",
    "typebox": "^1.3.34"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@opencode-ai/plugin": "*",
    "zod": "^4.3.6"
  }
}
